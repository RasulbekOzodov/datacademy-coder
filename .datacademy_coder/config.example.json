{
  "defaultProvider": "ollama",
  "providers": {
    "ollama": {
      "type": "ollama",
      "baseUrl": "http://localhost:11434",
      "model": "qwen2.5-coder:7b",
      "contextWindow": 16384,
      "keepAlive": "30m"
    },
    "lmstudio": {
      "type": "openai",
