{
  "name": "datacademy-coder",
  "version": "0.1.0",
  "description": "DataCademy Coder — terminal coding agent (Claude Code style) powered by local LLMs (Ollama, LM Studio, llama.cpp, vLLM) or any OpenAI-compatible API",
  "license": "MIT",
  "author": "DataCademy",
  "homepage": "https://github.com/RasulbekOzodov/datacademy-coder#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/RasulbekOzodov/datacademy-coder.git"
  },
  "keywords": ["ai", "coding-agent", "cli", "ollama", "llm", "local-llm", "claude-code", "codex", "deepseek", "qwen"],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "datacademy_coder": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "npm run build && npm test",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "diff": "^7.0.0",
    "fast-glob": "^3.3.2",
    "ignore": "^6.0.2",
    "jsonrepair": "^3.10.0",
    "picocolors": "^1.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/diff": "^6.0.0",
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
